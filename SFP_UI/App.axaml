<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SFP_UI.ViewModels"
             x:DataType="vm:AppViewModel"
             x:Class="SFP_UI.App"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:sty="using:FluentAvalonia.Styling"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <ResourceDictionary>
            <ui:FASymbolIconSource Symbol="Home" x:Key="HomeIcon" />
            <ui:FASymbolIconSource Symbol="HomeFilled" x:Key="HomeIconFilled" />
            <ui:FASymbolIconSource Symbol="Settings" x:Key="SettingsIcon" />
            <ui:FASymbolIconSource Symbol="SettingsFilled" x:Key="SettingsIconFilled" />
            <!--!Font Awesome Free v7.3.1 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2026 Fonticons, Inc.-->
